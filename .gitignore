# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# The vendored standalone Python backend runtime (Python + torch/CUDA/ultralytics venv) — several GB.
/backend/runtime/

# Large ONNX weights that exceed GitHub's 100 MB hard limit — ship in the release package, not the repo.
# det_10g.onnx (17 MB) is fine to track; w600k_r50.onnx (166 MB) is not.
backend/app/models/face/models/ibvap_face/w600k_r50.onnx

# Flutter Windows debug symbols — 240 MB, not needed for source control.
windows/flutter/ephemeral/*.pdb

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
